{
  "name": "rvu-sports-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Full Stack Sports Management Portal for RV University (React + Node.js/Express)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint",
    "test:server": "npm --prefix server test",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "keywords": [
    "rvu",
    "sports-portal",
    "full-stack",
    "react",
    "nodejs",
    "express"
  ],
  "author": "RV University FSD",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
